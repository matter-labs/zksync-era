{
  "separate-pull-requests": true,
  "group-pull-request-title-pattern": "chore: release ${component} ${branch}",
  "bootstrap-sha": "ff5f519b11cff863edcfa0f75af10fea113806b0",
  "last-release-sha": "ff5f519b11cff863edcfa0f75af10fea113806b0",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": true,
  "release-type": "simple",
  "packages": {
    "core": {
      "component": "core"
    },
    "prover": {
      "component": "prover",
      "extra-files": [
        {
          "type": "generic",
          "path": "Cargo.toml"
        }
      ]
    },
    "zkstack_cli": {
      "component": "zkstack_cli",
      "extra-files": [
        {
          "type": "generic",
          "path": "Cargo.toml"
        }
      ]
    },
    "airbender_prover_server": {
      "component": "airbender_prover_server",
      "extra-files": [
        {
          "type": "generic",
          "path": "Cargo.toml"
        }
      ]
    }
  }
}
